---
const title = "RWSCargo CRM - заявки";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #101418;
        --ink-soft: #343b42;
        --muted: #6f7882;
        --line: #e2e8e3;
        --line-strong: #d2ddd3;
        --page: #dceae4;
        --surface: #f6f7f2;
        --surface-soft: #eef4e7;
        --white: #ffffff;
        --graphite: #111820;
        --graphite-2: #061d2b;
        --accent: #f0441f;
        --accent-dark: #c73417;
        --accent-soft: #fff1eb;
        --mint: #35bea4;
        --mint-soft: #e6f6ec;
        --green: #1f8d5a;
        --amber: #a76208;
        --radius: 8px;
        --shadow: 0 24px 70px rgba(6, 29, 43, 0.09);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--ink);
        background:
          radial-gradient(circle at 18% 0%, rgba(240, 68, 31, 0.1), transparent 28%),
          linear-gradient(180deg, #dceae4 0%, #ecf2eb 46%, #f4f5ef 100%);
        font-family: Manrope, "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      }

      button,
      input,
      select {
        font: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button {
        cursor: pointer;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      [hidden] {
        display: none !important;
      }

      .login-view {
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: 24px;
      }

      .login-shell {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.58fr);
        width: min(1040px, 100%);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.74);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: var(--shadow);
        backdrop-filter: blur(22px);
      }

      .login-brand {
        display: grid;
        align-content: space-between;
        min-height: 520px;
        padding: 34px;
        color: var(--white);
        background:
          linear-gradient(135deg, rgba(240, 68, 31, 0.28), transparent 44%),
          linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 38%),
          var(--graphite-2);
      }

      .brand-logo,
      .sidebar-logo {
        display: inline-grid;
        gap: 2px;
        line-height: 1;
      }

      .brand-logo strong,
      .sidebar-logo strong {
        font-size: 24px;
        font-weight: 900;
      }

      .brand-logo span,
      .sidebar-logo span {
        color: var(--accent);
      }

      .brand-logo small,
      .sidebar-logo small {
        color: rgba(255, 255, 255, 0.62);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .login-copy {
        max-width: 560px;
      }

      .eyebrow {
        margin-bottom: 18px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .login-copy h1 {
        margin: 0 0 18px;
        color: var(--white);
        font-size: clamp(38px, 5vw, 68px);
        line-height: 0.96;
        letter-spacing: 0;
      }

      .login-copy p {
        max-width: 470px;
        margin: 0;
        color: rgba(255, 255, 255, 0.7);
        font-size: 17px;
        line-height: 1.55;
      }

      .login-form {
        display: grid;
        align-content: center;
        gap: 16px;
        padding: 34px;
      }

      .login-form h2 {
        margin: 0 0 4px;
        color: var(--ink);
        font-size: 30px;
        line-height: 1.05;
      }

      .login-form p {
        margin: 0 0 10px;
        color: var(--muted);
        line-height: 1.5;
      }

      .input-group {
        display: grid;
        gap: 8px;
      }

      .input-group label,
      .control-label,
      .block-title {
        color: var(--muted);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .input-group input,
      .search input,
      .status-select {
        width: 100%;
        min-height: 46px;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius);
        padding: 0 14px;
        color: var(--ink);
        background: var(--white);
        outline: none;
      }

      .input-group input:focus,
      .search input:focus,
      .status-select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(240, 68, 31, 0.1);
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        border: 0;
        border-radius: 999px;
        padding: 0 16px;
        color: var(--white);
        background: var(--accent);
        font-weight: 850;
        line-height: 1;
        box-shadow: 0 16px 34px rgba(240, 68, 31, 0.24);
        transition:
          transform 160ms ease,
          background 160ms ease,
          opacity 160ms ease;
      }

      .button:hover {
        background: var(--accent-dark);
        transform: translateY(-1px);
      }

      .button:disabled {
        opacity: 0.68;
        transform: none;
        cursor: default;
      }

      .button.secondary {
        border: 1px solid var(--line-strong);
        color: var(--ink);
        background: var(--white);
        box-shadow: none;
      }

      .button.ghost {
        min-height: 38px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        color: var(--ink-soft);
        background: rgba(255, 255, 255, 0.7);
        box-shadow: none;
        font-size: 13px;
      }

      .login-error {
        display: none;
        border: 1px solid rgba(180, 35, 24, 0.16);
        border-radius: var(--radius);
        padding: 12px;
        color: #b42318;
        background: #fff1f0;
        font-size: 13px;
        font-weight: 760;
      }

      .login-error.is-visible {
        display: block;
      }

      .app-shell {
        display: grid;
        grid-template-columns: 248px minmax(0, 1fr);
        gap: 16px;
        width: min(1540px, calc(100vw - 28px));
        margin: 0 auto;
        padding: 14px 0;
      }

      .sidebar {
        position: sticky;
        top: 14px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: 22px;
        height: calc(100svh - 28px);
        border: 1px solid rgba(255, 255, 255, 0.72);
        border-radius: 18px;
        padding: 18px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: var(--shadow);
        backdrop-filter: blur(22px);
      }

      .sidebar-logo {
        color: var(--ink);
      }

      .sidebar-logo small {
        color: var(--muted);
      }

      .nav {
        display: grid;
        align-content: start;
        gap: 6px;
      }

      .nav-item {
        display: grid;
        grid-template-columns: 26px minmax(0, 1fr);
        align-items: center;
        min-height: 42px;
        border-radius: 999px;
        padding: 0 12px 0 8px;
        color: var(--ink-soft);
        font-size: 14px;
        font-weight: 800;
      }

      .nav-item span:first-child {
        display: inline-grid;
        place-items: center;
        width: 24px;
        height: 24px;
        border-radius: 999px;
        background: rgba(6, 29, 43, 0.05);
        color: var(--accent);
        font-size: 12px;
      }

      .nav-item.is-active {
        color: var(--white);
        background: var(--accent);
      }

      .nav-item.is-active span:first-child {
        color: var(--accent);
        background: var(--white);
      }

      .sidebar-card {
        display: grid;
        gap: 12px;
        border-radius: 14px;
        padding: 16px;
        background: var(--surface-soft);
      }

      .sidebar-card strong {
        color: var(--ink);
        font-size: 15px;
        line-height: 1.2;
      }

      .sidebar-card span {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.45;
      }

      .content {
        min-width: 0;
      }

      .topbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 16px;
        align-items: center;
        margin-bottom: 12px;
        border: 1px solid rgba(255, 255, 255, 0.72);
        border-radius: 18px;
        padding: 14px;
        background: rgba(255, 255, 255, 0.7);
        box-shadow: 0 16px 44px rgba(6, 29, 43, 0.06);
        backdrop-filter: blur(22px);
      }

      .page-title {
        display: grid;
        gap: 5px;
      }

      .page-title h1 {
        margin: 0;
        color: var(--ink);
        font-size: clamp(28px, 3vw, 44px);
        line-height: 1.02;
        letter-spacing: 0;
      }

      .page-title span {
        color: var(--muted);
        font-size: 13px;
        font-weight: 760;
      }

      .top-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
      }

      .analytics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 10px;
      }

      .metric,
      .chart-card,
      .feed-panel {
        border: 1px solid rgba(255, 255, 255, 0.76);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.76);
        box-shadow: 0 16px 44px rgba(6, 29, 43, 0.06);
      }

      .metric {
        display: grid;
        gap: 18px;
        min-height: 128px;
        padding: 16px;
      }

      .metric.is-hot {
        color: var(--white);
        background:
          linear-gradient(135deg, rgba(240, 68, 31, 0.28), transparent 48%),
          var(--graphite);
      }

      .metric > span {
        color: var(--muted);
        font-size: 12px;
        font-weight: 850;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .metric.is-hot > span {
        color: rgba(255, 255, 255, 0.68);
      }

      .metric strong {
        font-size: clamp(34px, 4vw, 54px);
        line-height: 0.88;
      }

      .metric em {
        color: var(--muted);
        font-size: 12px;
        font-style: normal;
        font-weight: 760;
      }

      .metric.is-hot em {
        color: rgba(255, 255, 255, 0.62);
      }

      .charts {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
        gap: 10px;
        margin-bottom: 10px;
      }

      .chart-card {
        min-height: 220px;
        padding: 18px;
      }

      .chart-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }

      .chart-head strong {
        color: var(--ink);
        font-size: 18px;
      }

      .chart-head span {
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
      }

      .bar-chart {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        align-items: end;
        gap: 10px;
        height: 136px;
      }

      .bar-item {
        display: grid;
        align-content: end;
        gap: 8px;
        height: 100%;
      }

      .bar {
        min-height: 10px;
        border-radius: 999px 999px 6px 6px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent),
          var(--accent);
      }

      .bar-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 800;
        text-align: center;
      }

      .donut-layout {
        display: grid;
        grid-template-columns: 150px minmax(0, 1fr);
        gap: 18px;
        align-items: center;
      }

      .donut {
        position: relative;
        width: 138px;
        aspect-ratio: 1;
        border-radius: 50%;
        background: conic-gradient(var(--accent) 0deg, var(--line) 0deg);
      }

      .donut::after {
        content: "";
        position: absolute;
        inset: 18px;
        border-radius: 50%;
        background: var(--white);
      }

      .donut span {
        position: absolute;
        inset: 0;
        z-index: 1;
        display: grid;
        place-items: center;
        color: var(--ink);
        font-size: 32px;
        font-weight: 900;
      }

      .legend {
        display: grid;
        gap: 9px;
      }

      .legend-item {
        display: grid;
        grid-template-columns: 10px minmax(0, 1fr) auto;
        gap: 9px;
        align-items: center;
        color: var(--ink-soft);
        font-size: 13px;
        font-weight: 800;
      }

      .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--dot);
      }

      .feed-panel {
        overflow: hidden;
      }

      .feed-toolbar {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) auto;
        gap: 12px;
        align-items: end;
        padding: 14px;
        border-bottom: 1px solid rgba(18, 20, 22, 0.07);
      }

      .search {
        display: grid;
        gap: 6px;
      }

      .segments {
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--surface);
      }

      .segment {
        min-height: 36px;
        border: 0;
        border-radius: 999px;
        padding: 0 12px;
        color: var(--ink-soft);
        background: transparent;
        font-size: 13px;
        font-weight: 850;
        white-space: nowrap;
      }

      .segment.is-active {
        color: var(--white);
        background: var(--graphite);
      }

      .statusline {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 760;
      }

      .statusline strong {
        color: var(--ink);
      }

      .board {
        display: grid;
        gap: 8px;
        padding: 0 14px 14px;
      }

      .lead-card {
        overflow: hidden;
        border: 1px solid rgba(18, 20, 22, 0.07);
        border-radius: 14px;
        background: var(--white);
      }

      .lead-card:target {
        outline: 3px solid rgba(240, 68, 31, 0.22);
        outline-offset: 2px;
      }

      .lead-head {
        display: grid;
        grid-template-columns: minmax(210px, 0.68fr) minmax(260px, 1fr) minmax(220px, 0.75fr) 150px;
        gap: 14px;
        align-items: center;
        width: 100%;
        border: 0;
        padding: 14px;
        color: inherit;
        background: transparent;
        text-align: left;
      }

      .lead-person,
      .lead-brief,
      .lead-contact {
        display: grid;
        gap: 6px;
        min-width: 0;
      }

      .lead-date {
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
      }

      .lead-name {
        color: var(--ink);
        font-size: 18px;
        font-weight: 900;
        line-height: 1.16;
        overflow-wrap: anywhere;
      }

      .lead-id {
        color: var(--accent);
        font-size: 11px;
        font-weight: 850;
        overflow-wrap: anywhere;
      }

      .lead-title {
        color: var(--ink);
        font-size: 16px;
        font-weight: 900;
        overflow-wrap: anywhere;
      }

      .lead-subtitle {
        color: var(--muted);
        font-size: 13px;
        font-weight: 760;
        overflow-wrap: anywhere;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        justify-self: start;
        min-height: 30px;
        border-radius: 999px;
        padding: 0 10px;
        color: var(--status-ink);
        background: var(--status-bg);
        font-size: 12px;
        font-weight: 900;
      }

      .lead-body {
        display: grid;
        grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1fr) minmax(220px, 0.58fr);
        gap: 1px;
        border-top: 1px solid rgba(18, 20, 22, 0.07);
        background: var(--line);
      }

      .lead-body > section {
        min-width: 0;
        padding: 14px;
        background: rgba(255, 255, 255, 0.92);
      }

      .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: 10px;
      }

      .field {
        display: grid;
        gap: 5px;
        min-height: 62px;
        border: 1px solid rgba(18, 20, 22, 0.07);
        border-radius: var(--radius);
        padding: 9px;
        background: var(--surface);
      }

      .field span {
        color: var(--muted);
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .field strong,
      .field a {
        color: var(--ink);
        font-size: 13px;
        font-weight: 850;
        overflow-wrap: anywhere;
      }

      .field a {
        text-decoration: underline;
        text-decoration-color: rgba(240, 68, 31, 0.35);
        text-underline-offset: 3px;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        min-height: 28px;
        border: 1px solid rgba(18, 20, 22, 0.07);
        border-radius: 999px;
        padding: 0 9px;
        color: var(--ink-soft);
        background: var(--white);
        font-size: 12px;
        font-weight: 820;
      }

      .chip.is-accent {
        border-color: rgba(240, 68, 31, 0.24);
        color: var(--accent-dark);
        background: var(--accent-soft);
      }

      .comment {
        margin: 10px 0 0;
        border-left: 3px solid var(--accent);
        border-radius: 0 var(--radius) var(--radius) 0;
        padding: 11px 12px;
        color: var(--ink-soft);
        background: var(--accent-soft);
        font-size: 13px;
        line-height: 1.45;
      }

      .actions {
        display: grid;
        gap: 8px;
        margin-top: 10px;
      }

      .action-link,
      .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: 999px;
        padding: 0 12px;
        color: var(--ink);
        background: var(--white);
        font-size: 13px;
        font-weight: 850;
      }

      .action-link.primary {
        border-color: transparent;
        color: var(--white);
        background: var(--accent);
      }

      .action-button {
        width: 100%;
      }

      .status-control {
        display: grid;
        gap: 8px;
      }

      .notice {
        display: none;
        color: var(--green);
        font-size: 12px;
        font-weight: 850;
      }

      .notice.is-visible {
        display: block;
      }

      .empty,
      .error {
        display: grid;
        place-items: center;
        min-height: 260px;
        border: 1px solid rgba(18, 20, 22, 0.07);
        border-radius: 14px;
        padding: 28px;
        text-align: center;
        background: var(--white);
      }

      .empty strong,
      .error strong {
        display: block;
        margin-bottom: 8px;
        color: var(--ink);
        font-size: 24px;
      }

      .empty span,
      .error span {
        color: var(--muted);
        line-height: 1.45;
      }

      .error strong {
        color: #b42318;
      }

      @media (max-width: 1240px) {
        .app-shell {
          grid-template-columns: 92px minmax(0, 1fr);
        }

        .sidebar {
          padding: 14px;
        }

        .sidebar-logo small,
        .nav-item span:last-child,
        .sidebar-card span,
        .sidebar-card strong {
          display: none;
        }

        .nav-item {
          grid-template-columns: 1fr;
          justify-items: center;
          padding: 0;
        }

        .analytics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .lead-head {
          grid-template-columns: minmax(210px, 0.75fr) minmax(260px, 1fr) 150px;
        }

        .lead-contact {
          display: none;
        }

        .lead-body {
          grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1fr);
        }

        .lead-actions {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 900px) {
        .login-shell,
        .app-shell,
        .topbar,
        .feed-toolbar,
        .charts {
          grid-template-columns: 1fr;
        }

        .login-brand {
          min-height: 360px;
        }

        .app-shell {
          width: min(100vw - 20px, 720px);
          padding: 10px 0;
        }

        .sidebar {
          position: static;
          display: flex;
          align-items: center;
          justify-content: space-between;
          height: auto;
          border-radius: 16px;
        }

        .sidebar-logo small,
        .nav-item span:last-child {
          display: block;
        }

        .nav {
          display: flex;
          overflow-x: auto;
        }

        .nav-item {
          grid-template-columns: 24px minmax(0, 1fr);
          min-width: max-content;
          padding: 0 12px 0 8px;
        }

        .sidebar-card {
          display: none;
        }

        .analytics,
        .donut-layout {
          grid-template-columns: 1fr;
        }

        .top-actions,
        .segments {
          width: 100%;
        }

        .top-actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .segments {
          overflow-x: auto;
        }

        .segment {
          flex: 1;
        }

        .lead-head {
          position: relative;
          grid-template-columns: 1fr;
          gap: 8px;
          padding-right: 76px;
        }

        .lead-head::after {
          content: "Открыть";
          position: absolute;
          top: 14px;
          right: 14px;
          border-radius: 999px;
          padding: 7px 9px;
          color: var(--accent);
          background: var(--accent-soft);
          font-size: 11px;
          font-weight: 900;
        }

        .lead-card.is-expanded .lead-head::after {
          content: "Скрыть";
        }

        .lead-card:not(.is-expanded) .lead-body {
          display: none;
        }

        .lead-body,
        .details-grid {
          grid-template-columns: 1fr;
        }

        .statusline {
          flex-direction: column;
          gap: 5px;
        }
      }

      @media (max-width: 560px) {
        .login-view {
          padding: 10px;
        }

        .login-brand,
        .login-form,
        .chart-card,
        .metric,
        .feed-toolbar,
        .statusline,
        .lead-head,
        .lead-body > section {
          padding: 14px;
        }

        .top-actions {
          grid-template-columns: 1fr;
        }

        .page-title h1 {
          font-size: 30px;
        }

        .bar-chart {
          gap: 6px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .button {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <section class="login-view" id="login-view">
      <div class="login-shell">
        <div class="login-brand">
          <div class="brand-logo">
            <strong>RWS<span>Cargo</span></strong>
            <small>CRM access</small>
          </div>
          <div class="login-copy">
            <div class="eyebrow">Защищенный кабинет</div>
            <h1>Заявки, контакты и первичная обработка</h1>
            <p>Войдите под CRM-доступом, чтобы увидеть лиды с сайта, обновить статус и быстро связаться с клиентом.</p>
          </div>
        </div>
        <form class="login-form" id="login-form">
          <div>
            <h2>Вход в CRM</h2>
            <p>Используйте логин и пароль, выданные для RWSCargo CRM.</p>
          </div>
          <div class="input-group">
            <label for="login-user">Логин</label>
            <input id="login-user" name="user" autocomplete="username" required />
          </div>
          <div class="input-group">
            <label for="login-password">Пароль</label>
            <input id="login-password" name="password" type="password" autocomplete="current-password" required />
          </div>
          <div class="login-error" id="login-error">Не удалось войти. Проверьте логин и пароль.</div>
          <button class="button" id="login-submit" type="submit">Войти</button>
        </form>
      </div>
    </section>

    <main class="app-shell" id="crm-view" hidden>
      <aside class="sidebar">
        <div class="sidebar-logo">
          <strong>RWS<span>Cargo</span></strong>
          <small>Lead operations</small>
        </div>
        <nav class="nav" aria-label="Разделы CRM">
          <a class="nav-item" href="/"><span>↗</span><span>Сайт</span></a>
          <a class="nav-item is-active" href="/admin/leads/"><span>●</span><span>Заявки</span></a>
          <span class="nav-item"><span>◷</span><span>Аналитика</span></span>
          <span class="nav-item"><span>✓</span><span>Контроль</span></span>
        </nav>
        <div class="sidebar-card">
          <strong>Операторский режим</strong>
          <span>Новые заявки идут сверху. На телефоне карточки раскрываются нажатием.</span>
          <button class="button ghost" id="logout-side" type="button">Выйти</button>
        </div>
      </aside>

      <section class="content">
        <header class="topbar">
          <div class="page-title">
            <span>RWSCargo CRM / обработка лидов</span>
            <h1>Рабочий стол заявок</h1>
          </div>
          <div class="top-actions">
            <button class="button secondary" id="copy-link" type="button">Ссылка на CRM</button>
            <button class="button secondary" id="logout" type="button">Выйти</button>
            <button class="button" id="refresh" type="button">Обновить</button>
          </div>
        </header>

        <section class="analytics" aria-label="Сводка по заявкам">
          <article class="metric is-hot">
            <span>Новые</span>
            <strong id="count-new">0</strong>
            <em>требуют первого контакта</em>
          </article>
          <article class="metric">
            <span>В работе</span>
            <strong id="count-progress">0</strong>
            <em>уже взяты менеджером</em>
          </article>
          <article class="metric">
            <span>Закрытые</span>
            <strong id="count-closed">0</strong>
            <em>обработаны или неактуальны</em>
          </article>
          <article class="metric">
            <span>Всего</span>
            <strong id="count-total">0</strong>
            <em>последние 300 заявок</em>
          </article>
        </section>

        <section class="charts" aria-label="Аналитика заявок">
          <article class="chart-card">
            <div class="chart-head">
              <div>
                <strong>Заявки за 7 дней</strong>
                <span id="chart-subtitle">Данные появятся после загрузки</span>
              </div>
              <span id="last-updated">Последнее обновление: нет данных</span>
            </div>
            <div class="bar-chart" id="weekly-chart"></div>
          </article>

          <article class="chart-card">
            <div class="chart-head">
              <div>
                <strong>Статусы</strong>
                <span>Доля новых заявок</span>
              </div>
            </div>
            <div class="donut-layout">
              <div class="donut" id="status-donut"><span id="new-percent">0%</span></div>
              <div class="legend" id="status-legend"></div>
            </div>
          </article>
        </section>

        <section class="feed-panel">
          <div class="feed-toolbar">
            <div class="search">
              <label class="control-label" for="search">Поиск по имени, контакту, грузу или поставщику</label>
              <input id="search" type="search" placeholder="Например: Иван, WhatsApp, 1688, электроника" autocomplete="off" />
            </div>
            <div>
              <span class="control-label">Статус</span>
              <div class="segments" role="tablist" aria-label="Фильтр по статусу">
                <button class="segment is-active" type="button" data-filter="all">Все</button>
                <button class="segment" type="button" data-filter="new">Новые</button>
                <button class="segment" type="button" data-filter="in_progress">В работе</button>
                <button class="segment" type="button" data-filter="closed">Закрытые</button>
              </div>
            </div>
          </div>

          <div class="statusline">
            <span id="result-count">Загружаем заявки...</span>
            <span id="feed-hint">На ПК информация раскрыта сразу, на телефоне нажмите на заявку.</span>
          </div>

          <section class="board" id="app" aria-live="polite">
            <div class="empty">
              <div>
                <strong>Загружаем заявки</strong>
                <span>CRM получает данные с защищенного API.</span>
              </div>
            </div>
          </section>
        </section>
      </section>
    </main>

    <script is:inline>
      const AUTH_KEY = "rwscargo.crm.basicAuth";
      const loginView = document.querySelector("#login-view");
      const crmView = document.querySelector("#crm-view");
      const loginForm = document.querySelector("#login-form");
      const loginError = document.querySelector("#login-error");
      const loginSubmit = document.querySelector("#login-submit");
      const app = document.querySelector("#app");
      const refresh = document.querySelector("#refresh");
      const copyLink = document.querySelector("#copy-link");
      const logoutButtons = [document.querySelector("#logout"), document.querySelector("#logout-side")].filter(Boolean);
      const searchInput = document.querySelector("#search");
      const resultCount = document.querySelector("#result-count");
      const lastUpdated = document.querySelector("#last-updated");
      const chartSubtitle = document.querySelector("#chart-subtitle");
      const weeklyChart = document.querySelector("#weekly-chart");
      const statusDonut = document.querySelector("#status-donut");
      const newPercent = document.querySelector("#new-percent");
      const statusLegend = document.querySelector("#status-legend");
      const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
      const counters = {
        new: document.querySelector("#count-new"),
        progress: document.querySelector("#count-progress"),
        closed: document.querySelector("#count-closed"),
        total: document.querySelector("#count-total"),
      };
      const statuses = {
        new: { label: "Новая", color: "#f0441f", soft: "#fff1eb", ink: "#c73417" },
        in_progress: { label: "В работе", color: "#a76208", soft: "#fff7df", ink: "#7a4505" },
        closed: { label: "Закрыта", color: "#1f8d5a", soft: "#e6f6ec", ink: "#13643e" },
      };
      let leadsState = [];
      let filterState = "all";
      let searchState = "";
      let authHeader = sessionStorage.getItem(AUTH_KEY) || "";

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function basicAuth(user, password) {
        const bytes = new TextEncoder().encode(`${user}:${password}`);
        let binary = "";
        bytes.forEach((byte) => {
          binary += String.fromCharCode(byte);
        });
        return `Basic ${btoa(binary)}`;
      }

      function showLogin(message = "") {
        crmView.hidden = true;
        loginView.hidden = false;
        if (message) {
          loginError.textContent = message;
          loginError.classList.add("is-visible");
        }
      }

      function showCrm() {
        loginView.hidden = true;
        crmView.hidden = false;
        loginError.classList.remove("is-visible");
      }

      function logout() {
        authHeader = "";
        sessionStorage.removeItem(AUTH_KEY);
        leadsState = [];
        showLogin();
      }

      async function apiFetch(url, options = {}) {
        const headers = new Headers(options.headers || {});
        if (authHeader) headers.set("Authorization", authHeader);
        if (options.body && !headers.has("content-type")) headers.set("content-type", "application/json");
        return fetch(url, { ...options, headers, cache: "no-store" });
      }

      function linkify(value, type) {
        const text = String(value || "").trim();
        if (!text) return '<strong>не указан</strong>';
        if (type === "email") return `<a href="mailto:${escapeHtml(text)}">${escapeHtml(text)}</a>`;
        if (type === "phone") return `<a href="tel:${escapeHtml(text.replace(/\s/g, ""))}">${escapeHtml(text)}</a>`;
        if (type === "url" && /^https?:\/\//i.test(text)) return `<a href="${escapeHtml(text)}" target="_blank" rel="noreferrer">${escapeHtml(text)}</a>`;
        return `<strong>${escapeHtml(text)}</strong>`;
      }

      function formatDate(value, mode = "short") {
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return "дата не указана";
        return new Intl.DateTimeFormat("ru-RU", mode === "day"
          ? { day: "2-digit", month: "short" }
          : { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }).format(date);
      }

      function normalize(value) {
        return String(value ?? "").toLowerCase().trim();
      }

      function leadSearchBlob(lead) {
        const payload = lead.payload || {};
        return normalize([
          lead.id,
          lead.name,
          lead.phone,
          lead.email,
          lead.telegram,
          lead.whatsapp,
          lead.preferred_contact,
          lead.import_format,
          ...(lead.tasks || []),
          payload.supplierLink,
          payload.cargo,
          payload.weight,
          payload.volume,
          payload.city,
          payload.comment,
        ].join(" "));
      }

      function cleanPhone(value) {
        return String(value || "").replace(/[^\d+]/g, "");
      }

      function formatLeadText(lead) {
        const payload = lead.payload || {};
        return [
          "Заявка RWSCargo",
          `ID: ${lead.id}`,
          `Имя: ${lead.name || "не указано"}`,
          `Телефон: ${lead.phone || "не указан"}`,
          `Email: ${lead.email || "не указан"}`,
          `Telegram: ${lead.telegram || "не указан"}`,
          `WhatsApp: ${lead.whatsapp || "не указан"}`,
          `Формат: ${lead.import_format || "не выбран"}`,
          `Задачи: ${(lead.tasks || []).join(", ") || "не выбраны"}`,
          `Груз: ${payload.cargo || "не указан"}`,
          `Поставщик: ${payload.supplierLink || "не указан"}`,
          `Вес: ${payload.weight || "не указан"}`,
          `Объем: ${payload.volume || "не указан"}`,
          `Город: ${payload.city || "не указан"}`,
          `Комментарий: ${payload.comment || "не указан"}`,
        ].join("\n");
      }

      function updateCounters(leads) {
        counters.total.textContent = String(leads.length);
        counters.new.textContent = String(leads.filter((lead) => lead.status === "new").length);
        counters.progress.textContent = String(leads.filter((lead) => lead.status === "in_progress").length);
        counters.closed.textContent = String(leads.filter((lead) => lead.status === "closed").length);
      }

      function filteredLeads() {
        return leadsState.filter((lead) => {
          const statusMatch = filterState === "all" || lead.status === filterState;
          const searchMatch = !searchState || leadSearchBlob(lead).includes(searchState);
          return statusMatch && searchMatch;
        });
      }

      function updateAnalytics(leads) {
        updateCounters(leads);
        renderWeeklyChart(leads);
        renderStatusChart(leads);
      }

      function renderWeeklyChart(leads) {
        const days = Array.from({ length: 7 }, (_, index) => {
          const date = new Date();
          date.setHours(0, 0, 0, 0);
          date.setDate(date.getDate() - (6 - index));
          return date;
        });
        const counts = days.map((day) => {
          const next = new Date(day);
          next.setDate(day.getDate() + 1);
          return leads.filter((lead) => {
            const created = new Date(lead.created_at);
            return created >= day && created < next;
          }).length;
        });
        const max = Math.max(1, ...counts);
        weeklyChart.innerHTML = days.map((day, index) => {
          const height = Math.max(10, Math.round((counts[index] / max) * 100));
          return `
            <div class="bar-item" title="${counts[index]} заявок">
              <div class="bar" style="height:${height}%"></div>
              <div class="bar-label">${formatDate(day, "day")}</div>
            </div>
          `;
        }).join("");
        const total = counts.reduce((sum, count) => sum + count, 0);
        chartSubtitle.textContent = `${total} заявок за последние 7 дней`;
      }

      function renderStatusChart(leads) {
        if (!leads.length) {
          statusDonut.style.background = "var(--line)";
          newPercent.textContent = "0%";
          statusLegend.innerHTML = Object.entries(statuses).map(([, meta]) => `
            <div class="legend-item">
              <span class="legend-dot" style="--dot:${meta.color}"></span>
              <span>${meta.label}</span>
              <strong>0</strong>
            </div>
          `).join("");
          return;
        }

        const total = leads.length;
        const counts = {
          new: leads.filter((lead) => lead.status === "new").length,
          in_progress: leads.filter((lead) => lead.status === "in_progress").length,
          closed: leads.filter((lead) => lead.status === "closed").length,
        };
        const newDeg = (counts.new / total) * 360;
        const progressDeg = newDeg + (counts.in_progress / total) * 360;
        statusDonut.style.background = `conic-gradient(${statuses.new.color} 0deg ${newDeg}deg, ${statuses.in_progress.color} ${newDeg}deg ${progressDeg}deg, ${statuses.closed.color} ${progressDeg}deg 360deg)`;
        newPercent.textContent = `${Math.round((counts.new / total) * 100)}%`;
        statusLegend.innerHTML = Object.entries(statuses).map(([key, meta]) => `
          <div class="legend-item">
            <span class="legend-dot" style="--dot:${meta.color}"></span>
            <span>${meta.label}</span>
            <strong>${counts[key] || 0}</strong>
          </div>
        `).join("");
      }

      function statusOptions(active) {
        return Object.entries(statuses)
          .map(([value, meta]) => `<option value="${value}" ${active === value ? "selected" : ""}>${meta.label}</option>`)
          .join("");
      }

      function renderField(label, value, type) {
        return `
          <div class="field">
            <span>${escapeHtml(label)}</span>
            ${linkify(value, type)}
          </div>
        `;
      }

      function renderActions(lead) {
        const payload = lead.payload || {};
        const phone = cleanPhone(lead.phone || lead.whatsapp);
        const actions = [];
        if (phone) actions.push(`<a class="action-link primary" href="tel:${escapeHtml(phone)}">Позвонить</a>`);
        if (lead.email) actions.push(`<a class="action-link" href="mailto:${escapeHtml(lead.email)}">Написать email</a>`);
        if (payload.supplierLink && /^https?:\/\//i.test(payload.supplierLink)) {
          actions.push(`<a class="action-link" href="${escapeHtml(payload.supplierLink)}" target="_blank" rel="noreferrer">Открыть поставщика</a>`);
        }
        actions.push(`<button class="action-button" type="button" data-copy-lead="${escapeHtml(lead.id)}">Скопировать заявку</button>`);
        return actions.join("");
      }

      function renderLead(lead) {
        const payload = lead.payload || {};
        const status = statuses[lead.status] || statuses.new;
        const tasks = Array.isArray(lead.tasks) ? lead.tasks.filter(Boolean) : [];
        const mainContact = lead.phone || lead.email || lead.telegram || lead.whatsapp || "контакт не указан";
        const hasCalculator = payload.calculator && typeof payload.calculator === "object";
        const statusStyle = `--status-bg:${status.soft}; --status-ink:${status.ink}`;

        return `
          <article class="lead-card" id="${escapeHtml(lead.id)}" data-lead-card="${escapeHtml(lead.id)}">
            <button class="lead-head" type="button" data-toggle-card="${escapeHtml(lead.id)}">
              <span class="lead-person">
                <span class="lead-date">${formatDate(lead.created_at)}</span>
                <span class="lead-name">${escapeHtml(lead.name || "Клиент без имени")}</span>
                <span class="lead-id">${escapeHtml(lead.id)}</span>
              </span>
              <span class="lead-brief">
                <span class="lead-title">${escapeHtml(payload.cargo || "Груз не указан")}</span>
                <span class="lead-subtitle">${escapeHtml(payload.comment || payload.supplierLink || "Нет комментария")}</span>
              </span>
              <span class="lead-contact">
                <span class="lead-title">${escapeHtml(mainContact)}</span>
                <span class="lead-subtitle">Удобно: ${escapeHtml(lead.preferred_contact || "не выбрано")}</span>
              </span>
              <span class="status-pill" style="${statusStyle}">${status.label}</span>
            </button>

            <div class="lead-body">
              <section>
                <span class="block-title">Связь с клиентом</span>
                <div class="details-grid">
                  ${renderField("Телефон", lead.phone, "phone")}
                  ${renderField("Email", lead.email, "email")}
                  ${renderField("Telegram", lead.telegram)}
                  ${renderField("WhatsApp", lead.whatsapp, "phone")}
                </div>
                <div class="chips">
                  <span class="chip is-accent">Удобно: ${escapeHtml(lead.preferred_contact || "не выбрано")}</span>
                  <span class="chip">Формат: ${escapeHtml(lead.import_format || "не выбран")}</span>
                </div>
              </section>

              <section>
                <span class="block-title">Груз и задача</span>
                <div class="chips">
                  ${tasks.length ? tasks.map((task) => `<span class="chip">${escapeHtml(task)}</span>`).join("") : '<span class="chip">задачи не выбраны</span>'}
                  ${hasCalculator ? `<span class="chip is-accent">Калькулятор: ${escapeHtml(payload.calculator.estimate || "прикреплен")}</span>` : ""}
                  ${payload.city ? `<span class="chip">Город: ${escapeHtml(payload.city)}</span>` : ""}
                </div>
                <div class="details-grid">
                  ${renderField("Поставщик", payload.supplierLink, "url")}
                  ${renderField("Вес", payload.weight)}
                  ${renderField("Объем", payload.volume)}
                  ${renderField("Источник", lead.source)}
                </div>
                <p class="comment">${escapeHtml(payload.comment || "Комментарий не указан")}</p>
              </section>

              <section class="lead-actions">
                <div class="status-control">
                  <label class="block-title" for="status-${escapeHtml(lead.id)}">Статус заявки</label>
                  <select class="status-select" id="status-${escapeHtml(lead.id)}" data-lead-status="${escapeHtml(lead.id)}">
                    ${statusOptions(lead.status)}
                  </select>
                  <span class="notice">Статус сохранен</span>
                </div>
                <div class="actions">${renderActions(lead)}</div>
              </section>
            </div>
          </article>
        `;
      }

      function render() {
        updateAnalytics(leadsState);
        const visibleLeads = filteredLeads();
        resultCount.innerHTML = `Показано: <strong>${visibleLeads.length}</strong> из <strong>${leadsState.length}</strong>`;

        if (!leadsState.length) {
          app.innerHTML = `
            <div class="empty">
              <div>
                <strong>Пока заявок нет</strong>
                <span>Когда форма на сайте отправит первую заявку, она появится здесь.</span>
              </div>
            </div>
          `;
          return;
        }

        if (!visibleLeads.length) {
          app.innerHTML = `
            <div class="empty">
              <div>
                <strong>Ничего не найдено</strong>
                <span>Попробуйте другой статус или более короткий поисковый запрос.</span>
              </div>
            </div>
          `;
          return;
        }

        app.innerHTML = visibleLeads.map(renderLead).join("");
        bindLeadControls();
      }

      function bindLeadControls() {
        app.querySelectorAll("[data-toggle-card]").forEach((button) => {
          button.addEventListener("click", (event) => {
            if (event.target.closest("a, select, button:not([data-toggle-card])")) return;
            button.closest("[data-lead-card]")?.classList.toggle("is-expanded");
          });
        });

        app.querySelectorAll("[data-copy-lead]").forEach((button) => {
          button.addEventListener("click", async () => {
            const id = button.getAttribute("data-copy-lead");
            const lead = leadsState.find((item) => item.id === id);
            if (!lead) return;
            await navigator.clipboard?.writeText(formatLeadText(lead));
            button.textContent = "Заявка скопирована";
            window.setTimeout(() => {
              button.textContent = "Скопировать заявку";
            }, 1400);
          });
        });

        app.querySelectorAll("[data-lead-status]").forEach((select) => {
          select.addEventListener("change", async () => {
            const card = select.closest("[data-lead-card]");
            const id = card?.getAttribute("data-lead-card");
            const notice = card?.querySelector(".notice");
            const previous = leadsState.find((lead) => lead.id === id)?.status;
            select.disabled = true;

            try {
              const response = await apiFetch(`/api/leads/${id}`, {
                method: "PATCH",
                body: JSON.stringify({ status: select.value }),
              });
              const result = await response.json().catch(() => ({}));

              if (!response.ok || !result.ok) {
                throw new Error(result.error || "Не удалось сохранить статус");
              }

              leadsState = leadsState.map((lead) => (lead.id === id ? { ...lead, status: select.value, updated_at: new Date().toISOString() } : lead));
              updateAnalytics(leadsState);
              const visibleLeads = filteredLeads();
              resultCount.innerHTML = `Показано: <strong>${visibleLeads.length}</strong> из <strong>${leadsState.length}</strong>`;
              const pill = card?.querySelector(".status-pill");
              const meta = statuses[select.value] || statuses.new;
              if (pill) {
                pill.textContent = meta.label;
                pill.style.setProperty("--status-bg", meta.soft);
                pill.style.setProperty("--status-ink", meta.ink);
              }
              if (notice) {
                notice.textContent = "Статус сохранен";
                notice.classList.add("is-visible");
                window.setTimeout(() => notice.classList.remove("is-visible"), 1600);
              }

              if (filterState !== "all" && filterState !== select.value) {
                window.setTimeout(render, 700);
              }
            } catch (error) {
              select.value = previous || "new";
              if (notice) {
                notice.textContent = error.message || "Ошибка сохранения";
                notice.classList.add("is-visible");
                window.setTimeout(() => notice.classList.remove("is-visible"), 2400);
              }
            } finally {
              select.disabled = false;
            }
          });
        });
      }

      async function load() {
        refresh.disabled = true;
        refresh.textContent = "Обновляем...";

        try {
          const response = await apiFetch("/api/leads");
          const result = await response.json().catch(() => ({}));

          if (response.status === 401) {
            throw new Error("Неверный логин или пароль CRM.");
          }

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Не удалось загрузить заявки");
          }

          leadsState = Array.isArray(result.leads) ? result.leads : [];
          lastUpdated.textContent = `Последнее обновление: ${new Intl.DateTimeFormat("ru-RU", { timeStyle: "short" }).format(new Date())}`;
          showCrm();
          render();
          return true;
        } catch (error) {
          if (error.message.includes("логин") || error.message.includes("пароль")) {
            sessionStorage.removeItem(AUTH_KEY);
            showLogin(error.message);
          } else {
            resultCount.textContent = "Ошибка загрузки";
            app.innerHTML = `
              <div class="error">
                <div>
                  <strong>Не удалось загрузить заявки</strong>
                  <span>${escapeHtml(error.message || "Проверьте доступ к CRM.")}</span>
                </div>
              </div>
            `;
            showCrm();
          }
          return false;
        } finally {
          refresh.disabled = false;
          refresh.textContent = "Обновить";
        }
      }

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = new FormData(loginForm);
        authHeader = basicAuth(String(form.get("user") || ""), String(form.get("password") || ""));
        loginSubmit.disabled = true;
        loginSubmit.textContent = "Проверяем...";
        loginError.classList.remove("is-visible");

        const ok = await load();
        if (ok) {
          sessionStorage.setItem(AUTH_KEY, authHeader);
          loginForm.reset();
        }

        loginSubmit.disabled = false;
        loginSubmit.textContent = "Войти";
      });

      refresh.addEventListener("click", load);
      logoutButtons.forEach((button) => button.addEventListener("click", logout));
      searchInput.addEventListener("input", () => {
        searchState = normalize(searchInput.value);
        render();
      });
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          filterState = button.getAttribute("data-filter") || "all";
          filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
          render();
        });
      });
      copyLink.addEventListener("click", async () => {
        await navigator.clipboard?.writeText(window.location.href);
        copyLink.textContent = "Ссылка скопирована";
        window.setTimeout(() => {
          copyLink.textContent = "Ссылка на CRM";
        }, 1400);
      });

      if (authHeader) {
        load();
      } else {
        showLogin();
      }
    </script>
  </body>
</html>
