---
const title = "RWSCargo CRM - заявки";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #101418;
        --ink-soft: #343b42;
        --muted: #6f7882;
        --line: #dfe4e8;
        --surface: #f3f2ee;
        --surface-strong: #e8e7e1;
        --white: #ffffff;
        --graphite: #111820;
        --graphite-2: #061d2b;
        --accent: #f0441f;
        --accent-dark: #c73417;
        --accent-soft: #fff1eb;
        --green: #1f8d5a;
        --amber: #a76208;
        --radius: 8px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-width: 320px;
        color: var(--ink);
        background:
          linear-gradient(180deg, rgba(6, 29, 43, 0.06), transparent 320px),
          var(--surface);
        font-family: Manrope, "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      }

      button,
      input,
      select {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      .shell {
        width: min(1440px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 22px 0 36px;
      }

      .topbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        min-height: 78px;
        margin-bottom: 18px;
        padding: 16px 18px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: var(--radius);
        color: var(--white);
        background:
          linear-gradient(135deg, rgba(240, 68, 31, 0.18), transparent 42%),
          var(--graphite-2);
        box-shadow: 0 26px 70px rgba(6, 29, 43, 0.16);
      }

      .brand {
        display: grid;
        gap: 6px;
      }

      .brand-mark {
        color: rgba(255, 255, 255, 0.62);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        color: var(--white);
        font-size: clamp(30px, 4vw, 56px);
        line-height: 0.98;
        font-weight: 850;
        letter-spacing: 0;
      }

      .top-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        border: 0;
        border-radius: 999px;
        padding: 0 16px;
        color: var(--white);
        background: var(--accent);
        font-weight: 850;
        line-height: 1;
        box-shadow: 0 16px 34px rgba(240, 68, 31, 0.28);
        transition:
          transform 160ms ease,
          background 160ms ease,
          opacity 160ms ease;
      }

      .button:hover {
        background: var(--accent-dark);
        transform: translateY(-1px);
      }

      .button:disabled {
        opacity: 0.68;
        transform: none;
        cursor: default;
      }

      .button.secondary {
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.09);
        box-shadow: none;
      }

      .button.secondary:hover {
        background: rgba(255, 255, 255, 0.14);
      }

      .dashboard {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
      }

      .metric {
        display: grid;
        gap: 18px;
        min-height: 132px;
        padding: 18px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: var(--radius);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0.72)),
          var(--surface);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.76) inset;
      }

      .metric strong {
        font-size: clamp(32px, 4vw, 52px);
        line-height: 0.9;
      }

      .metric span {
        color: var(--muted);
        font-size: 13px;
        font-weight: 800;
      }

      .metric.is-hot {
        color: var(--white);
        border-color: rgba(255, 255, 255, 0.14);
        background:
          linear-gradient(135deg, rgba(240, 68, 31, 0.24), transparent 46%),
          var(--graphite);
      }

      .metric.is-hot span {
        color: rgba(255, 255, 255, 0.68);
      }

      .toolbar {
        display: grid;
        grid-template-columns: minmax(280px, 1fr) auto;
        gap: 12px;
        align-items: center;
        margin-bottom: 12px;
        padding: 12px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.82);
      }

      .search {
        display: grid;
        gap: 6px;
      }

      .search label,
      .filters-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .search input {
        width: 100%;
        min-height: 44px;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0 14px;
        color: var(--ink);
        background: var(--white);
        outline: none;
      }

      .search input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(240, 68, 31, 0.1);
      }

      .filters {
        display: grid;
        gap: 6px;
        justify-items: end;
      }

      .segments {
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--surface);
      }

      .segment {
        min-height: 36px;
        border: 0;
        border-radius: 999px;
        padding: 0 12px;
        color: var(--ink-soft);
        background: transparent;
        font-size: 13px;
        font-weight: 850;
        white-space: nowrap;
      }

      .segment.is-active {
        color: var(--white);
        background: var(--graphite);
      }

      .statusline {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }

      .statusline strong {
        color: var(--ink);
      }

      .board {
        display: grid;
        gap: 10px;
      }

      .lead-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.2fr) minmax(240px, 0.92fr);
        gap: 1px;
        overflow: hidden;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: var(--radius);
        background: var(--line);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.8) inset,
          0 18px 38px rgba(6, 29, 43, 0.06);
      }

      .lead-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        background: var(--status-color, var(--accent));
      }

      .lead-card:target {
        outline: 3px solid rgba(240, 68, 31, 0.24);
        outline-offset: 2px;
      }

      .lead-card > section {
        min-width: 0;
        padding: 18px;
        background: rgba(255, 255, 255, 0.9);
      }

      .lead-main {
        display: grid;
        align-content: space-between;
        gap: 18px;
      }

      .lead-date {
        color: var(--muted);
        font-size: 13px;
        font-weight: 760;
      }

      .lead-name {
        display: grid;
        gap: 8px;
      }

      .lead-name strong {
        color: var(--ink);
        font-size: 22px;
        line-height: 1.08;
      }

      .lead-id {
        color: var(--accent);
        font-size: 12px;
        font-weight: 850;
        overflow-wrap: anywhere;
      }

      .status-control {
        display: grid;
        gap: 8px;
      }

      .status-control label,
      .block-title {
        color: var(--muted);
        font-size: 11px;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .status-select {
        width: 100%;
        min-height: 42px;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0 12px;
        color: var(--ink);
        background: var(--white);
        outline: none;
      }

      .status-select:focus {
        border-color: var(--accent);
      }

      .contacts,
      .cargo,
      .brief {
        display: grid;
        align-content: start;
        gap: 12px;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
      }

      .field {
        display: grid;
        gap: 5px;
        min-height: 66px;
        padding: 10px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: 6px;
        background: rgba(243, 242, 238, 0.72);
      }

      .field span {
        color: var(--muted);
        font-size: 11px;
        font-weight: 850;
        text-transform: uppercase;
      }

      .field strong,
      .field a {
        color: var(--ink);
        font-size: 14px;
        font-weight: 800;
        overflow-wrap: anywhere;
      }

      .field a {
        text-decoration: underline;
        text-decoration-color: rgba(240, 68, 31, 0.35);
        text-underline-offset: 3px;
      }

      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: 999px;
        padding: 0 10px;
        color: var(--ink-soft);
        background: var(--white);
        font-size: 12px;
        font-weight: 800;
      }

      .chip.is-accent {
        border-color: rgba(240, 68, 31, 0.28);
        color: var(--accent-dark);
        background: var(--accent-soft);
      }

      .cargo-title {
        display: grid;
        gap: 8px;
      }

      .cargo-title strong {
        color: var(--ink);
        font-size: 20px;
        line-height: 1.12;
      }

      .cargo-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
      }

      .comment {
        margin: 0;
        padding: 12px;
        border-left: 3px solid var(--accent);
        border-radius: 0 6px 6px 0;
        color: var(--ink-soft);
        background: rgba(255, 241, 235, 0.8);
        font-size: 14px;
        line-height: 1.45;
      }

      .notice {
        display: none;
        margin-top: 2px;
        color: var(--green);
        font-size: 12px;
        font-weight: 850;
      }

      .notice.is-visible {
        display: block;
      }

      .empty,
      .error {
        display: grid;
        place-items: center;
        min-height: 280px;
        border: 1px solid rgba(18, 20, 22, 0.08);
        border-radius: var(--radius);
        padding: 34px;
        text-align: center;
        background: rgba(255, 255, 255, 0.82);
      }

      .empty strong,
      .error strong {
        display: block;
        margin-bottom: 8px;
        color: var(--ink);
        font-size: 24px;
      }

      .empty span,
      .error span {
        color: var(--muted);
        line-height: 1.45;
      }

      .error strong {
        color: #b42318;
      }

      @media (max-width: 1180px) {
        .dashboard {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .lead-card {
          grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1fr);
        }

        .brief {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 820px) {
        .shell {
          width: min(100vw - 20px, 720px);
          padding-top: 10px;
        }

        .topbar,
        .toolbar,
        .lead-card {
          grid-template-columns: 1fr;
        }

        .top-actions,
        .filters {
          justify-content: stretch;
          justify-items: stretch;
        }

        .button,
        .segments {
          width: 100%;
        }

        .segment {
          flex: 1;
          padding: 0 8px;
          font-size: 12px;
        }

        .dashboard,
        .contact-grid,
        .cargo-meta {
          grid-template-columns: 1fr;
        }

        .statusline {
          flex-direction: column;
          gap: 6px;
        }

        .lead-card > section,
        .metric {
          padding: 16px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .button {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <div class="brand">
          <span class="brand-mark">RWSCargo / мини-CRM</span>
          <h1>Заявки и первичная обработка</h1>
        </div>
        <div class="top-actions">
          <button class="button secondary" id="copy-link" type="button">Ссылка на CRM</button>
          <button class="button" id="refresh" type="button">Обновить</button>
        </div>
      </header>

      <section class="dashboard" aria-label="Сводка по заявкам">
        <article class="metric is-hot">
          <strong id="count-new">0</strong>
          <span>Новые заявки</span>
        </article>
        <article class="metric">
          <strong id="count-progress">0</strong>
          <span>В работе</span>
        </article>
        <article class="metric">
          <strong id="count-closed">0</strong>
          <span>Закрытые</span>
        </article>
        <article class="metric">
          <strong id="count-total">0</strong>
          <span>Всего в CRM</span>
        </article>
      </section>

      <section class="toolbar" aria-label="Фильтры заявок">
        <div class="search">
          <label for="search">Поиск по имени, контакту, грузу или поставщику</label>
          <input id="search" type="search" placeholder="Например: Иван, WhatsApp, 1688, электроника" autocomplete="off" />
        </div>
        <div class="filters">
          <span class="filters-label">Статус</span>
          <div class="segments" role="tablist" aria-label="Фильтр по статусу">
            <button class="segment is-active" type="button" data-filter="all">Все</button>
            <button class="segment" type="button" data-filter="new">Новые</button>
            <button class="segment" type="button" data-filter="in_progress">В работе</button>
            <button class="segment" type="button" data-filter="closed">Закрытые</button>
          </div>
        </div>
      </section>

      <div class="statusline">
        <span id="result-count">Загружаем заявки...</span>
        <span id="last-updated">Последнее обновление: нет данных</span>
      </div>

      <section class="board" id="app" aria-live="polite">
        <div class="empty">
          <div>
            <strong>Загружаем заявки</strong>
            <span>CRM получает данные с защищенного API.</span>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const app = document.querySelector("#app");
      const refresh = document.querySelector("#refresh");
      const copyLink = document.querySelector("#copy-link");
      const searchInput = document.querySelector("#search");
      const resultCount = document.querySelector("#result-count");
      const lastUpdated = document.querySelector("#last-updated");
      const filterButtons = Array.from(document.querySelectorAll("[data-filter]"));
      const counters = {
        new: document.querySelector("#count-new"),
        progress: document.querySelector("#count-progress"),
        closed: document.querySelector("#count-closed"),
        total: document.querySelector("#count-total"),
      };
      const statuses = {
        new: { label: "Новая", color: "#f0441f" },
        in_progress: { label: "В работе", color: "#a76208" },
        closed: { label: "Закрыта", color: "#1f8d5a" },
      };
      let leadsState = [];
      let filterState = "all";
      let searchState = "";

      function escapeHtml(value) {
        return String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function linkify(value, type) {
        const text = String(value || "").trim();

        if (!text) return '<strong>не указан</strong>';
        if (type === "email") return `<a href="mailto:${escapeHtml(text)}">${escapeHtml(text)}</a>`;
        if (type === "phone") return `<a href="tel:${escapeHtml(text.replace(/\s/g, ""))}">${escapeHtml(text)}</a>`;
        if (type === "url" && /^https?:\/\//i.test(text)) return `<a href="${escapeHtml(text)}" target="_blank" rel="noreferrer">${escapeHtml(text)}</a>`;

        return `<strong>${escapeHtml(text)}</strong>`;
      }

      function formatDate(value) {
        const date = new Date(value);

        if (Number.isNaN(date.getTime())) return "дата не указана";

        return new Intl.DateTimeFormat("ru-RU", {
          day: "2-digit",
          month: "short",
          hour: "2-digit",
          minute: "2-digit",
        }).format(date);
      }

      function normalize(value) {
        return String(value ?? "").toLowerCase().trim();
      }

      function leadSearchBlob(lead) {
        const payload = lead.payload || {};

        return normalize([
          lead.id,
          lead.name,
          lead.phone,
          lead.email,
          lead.telegram,
          lead.whatsapp,
          lead.preferred_contact,
          lead.import_format,
          ...(lead.tasks || []),
          payload.supplierLink,
          payload.cargo,
          payload.weight,
          payload.volume,
          payload.city,
          payload.comment,
        ].join(" "));
      }

      function updateCounters(leads) {
        counters.total.textContent = String(leads.length);
        counters.new.textContent = String(leads.filter((lead) => lead.status === "new").length);
        counters.progress.textContent = String(leads.filter((lead) => lead.status === "in_progress").length);
        counters.closed.textContent = String(leads.filter((lead) => lead.status === "closed").length);
      }

      function filteredLeads() {
        return leadsState.filter((lead) => {
          const statusMatch = filterState === "all" || lead.status === filterState;
          const searchMatch = !searchState || leadSearchBlob(lead).includes(searchState);

          return statusMatch && searchMatch;
        });
      }

      function statusOptions(active) {
        return Object.entries(statuses)
          .map(([value, meta]) => `<option value="${value}" ${active === value ? "selected" : ""}>${meta.label}</option>`)
          .join("");
      }

      function renderField(label, value, type) {
        return `
          <div class="field">
            <span>${escapeHtml(label)}</span>
            ${linkify(value, type)}
          </div>
        `;
      }

      function renderLead(lead) {
        const payload = lead.payload || {};
        const status = statuses[lead.status] || statuses.new;
        const tasks = Array.isArray(lead.tasks) ? lead.tasks.filter(Boolean) : [];
        const hasCalculator = payload.calculator && typeof payload.calculator === "object";

        return `
          <article class="lead-card" id="${escapeHtml(lead.id)}" style="--status-color: ${status.color}">
            <section class="lead-main">
              <div class="lead-name">
                <span class="lead-date">${formatDate(lead.created_at)}</span>
                <strong>${escapeHtml(lead.name || "Клиент без имени")}</strong>
                <span class="lead-id">${escapeHtml(lead.id)}</span>
              </div>
              <div class="status-control">
                <label for="status-${escapeHtml(lead.id)}">Статус заявки</label>
                <select class="status-select" id="status-${escapeHtml(lead.id)}" data-lead-status="${escapeHtml(lead.id)}">
                  ${statusOptions(lead.status)}
                </select>
                <span class="notice" data-status-notice="${escapeHtml(lead.id)}">Статус сохранен</span>
              </div>
            </section>

            <section class="contacts">
              <span class="block-title">Связь с клиентом</span>
              <div class="contact-grid">
                ${renderField("Телефон", lead.phone, "phone")}
                ${renderField("Email", lead.email, "email")}
                ${renderField("Telegram", lead.telegram)}
                ${renderField("WhatsApp", lead.whatsapp, "phone")}
              </div>
              <div class="chips">
                <span class="chip is-accent">Удобно: ${escapeHtml(lead.preferred_contact || "не выбрано")}</span>
                <span class="chip">Формат: ${escapeHtml(lead.import_format || "не выбран")}</span>
              </div>
            </section>

            <section class="brief">
              <div class="cargo-title">
                <span class="block-title">Груз и задача</span>
                <strong>${escapeHtml(payload.cargo || "Груз не указан")}</strong>
              </div>
              <div class="chips">
                ${tasks.length ? tasks.map((task) => `<span class="chip">${escapeHtml(task)}</span>`).join("") : '<span class="chip">задачи не выбраны</span>'}
                ${hasCalculator ? `<span class="chip is-accent">Калькулятор: ${escapeHtml(payload.calculator.estimate || "прикреплен")}</span>` : ""}
              </div>
              <div class="cargo-meta">
                ${renderField("Поставщик", payload.supplierLink, "url")}
                ${renderField("Вес", payload.weight)}
                ${renderField("Объем", payload.volume)}
              </div>
              ${payload.city ? `<div class="chips"><span class="chip">Город: ${escapeHtml(payload.city)}</span></div>` : ""}
              <p class="comment">${escapeHtml(payload.comment || "Комментарий не указан")}</p>
            </section>
          </article>
        `;
      }

      function render() {
        updateCounters(leadsState);
        const visibleLeads = filteredLeads();
        resultCount.innerHTML = `Показано: <strong>${visibleLeads.length}</strong> из <strong>${leadsState.length}</strong>`;

        if (!leadsState.length) {
          app.innerHTML = `
            <div class="empty">
              <div>
                <strong>Пока заявок нет</strong>
                <span>Когда форма на сайте отправит первую заявку, она появится здесь.</span>
              </div>
            </div>
          `;
          return;
        }

        if (!visibleLeads.length) {
          app.innerHTML = `
            <div class="empty">
              <div>
                <strong>Ничего не найдено</strong>
                <span>Попробуйте другой статус или более короткий поисковый запрос.</span>
              </div>
            </div>
          `;
          return;
        }

        app.innerHTML = visibleLeads.map(renderLead).join("");
        bindStatusControls();
      }

      function bindStatusControls() {
        app.querySelectorAll("[data-lead-status]").forEach((select) => {
          select.addEventListener("change", async () => {
            const id = select.getAttribute("data-lead-status");
            const notice = app.querySelector(`[data-status-notice="${id}"]`);
            const previous = leadsState.find((lead) => lead.id === id)?.status;
            select.disabled = true;

            try {
              const response = await fetch(`/api/leads/${id}`, {
                method: "PATCH",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ status: select.value }),
              });
              const result = await response.json().catch(() => ({}));

              if (!response.ok || !result.ok) {
                throw new Error(result.error || "Не удалось сохранить статус");
              }

              leadsState = leadsState.map((lead) => (lead.id === id ? { ...lead, status: select.value, updated_at: new Date().toISOString() } : lead));
              updateCounters(leadsState);
              const visibleLeads = filteredLeads();
              resultCount.innerHTML = `Показано: <strong>${visibleLeads.length}</strong> из <strong>${leadsState.length}</strong>`;
              select.closest(".lead-card")?.style.setProperty("--status-color", statuses[select.value]?.color || statuses.new.color);

              if (notice) {
                notice.textContent = "Статус сохранен";
                notice.classList.add("is-visible");
                window.setTimeout(() => notice.classList.remove("is-visible"), 1600);
              }

              if (filterState !== "all" && filterState !== select.value) {
                window.setTimeout(render, 700);
              }
            } catch (error) {
              select.value = previous || "new";
              if (notice) {
                notice.textContent = error.message || "Ошибка сохранения";
                notice.classList.add("is-visible");
                window.setTimeout(() => notice.classList.remove("is-visible"), 2400);
              }
            } finally {
              select.disabled = false;
            }
          });
        });
      }

      async function load() {
        refresh.disabled = true;
        refresh.textContent = "Обновляем...";

        try {
          const response = await fetch("/api/leads", { cache: "no-store" });
          const result = await response.json();

          if (!response.ok || !result.ok) {
            throw new Error(result.error || "Не удалось загрузить заявки");
          }

          leadsState = Array.isArray(result.leads) ? result.leads : [];
          lastUpdated.textContent = `Последнее обновление: ${new Intl.DateTimeFormat("ru-RU", { timeStyle: "short" }).format(new Date())}`;
          render();
        } catch (error) {
          resultCount.textContent = "Ошибка загрузки";
          app.innerHTML = `
            <div class="error">
              <div>
                <strong>Не удалось загрузить заявки</strong>
                <span>${escapeHtml(error.message || "Проверьте логин и пароль CRM.")}</span>
              </div>
            </div>
          `;
        } finally {
          refresh.disabled = false;
          refresh.textContent = "Обновить";
        }
      }

      refresh.addEventListener("click", load);
      searchInput.addEventListener("input", () => {
        searchState = normalize(searchInput.value);
        render();
      });
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          filterState = button.getAttribute("data-filter") || "all";
          filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
          render();
        });
      });
      copyLink.addEventListener("click", async () => {
        await navigator.clipboard?.writeText(window.location.href);
        copyLink.textContent = "Ссылка скопирована";
        window.setTimeout(() => {
          copyLink.textContent = "Ссылка на CRM";
        }, 1400);
      });

      load();
    </script>
  </body>
</html>
